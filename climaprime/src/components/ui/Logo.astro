---
/**
 * Logo provisória em código (ícone + nome). Quando company.logo.image estiver
 * preenchido, a imagem real do cliente é usada no lugar.
 */
import { company } from '../../config/company';

interface Props { onDark?: boolean; class?: string }
const { onDark = false, class: className = '' } = Astro.props;
const { logo } = company;
const image = onDark ? logo.imageOnDark ?? logo.image : logo.image;
---

<a href="/" class:list={['logo', { 'logo--dark': onDark }, className]} aria-label={`${company.name} — página inicial`}>
  {
    image ? (
      <img src={image} alt={company.name} width={logo.width} height={logo.height} />
    ) : (
      <>
        <span class="logo__mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="40" height="40">
            <defs>
              <linearGradient id={`lg-${onDark ? 'd' : 'l'}`} x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="var(--c-brand-light)" />
                <stop offset="1" stop-color="var(--c-primary-deep)" />
              </linearGradient>
            </defs>
            <rect width="40" height="40" rx="11" fill={`url(#lg-${onDark ? 'd' : 'l'})`} />
            <g fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round">
              <path d="M20 9.5v21M10.9 14.75l18.2 10.5M10.9 25.25l18.2-10.5" />
              <path d="M16.6 10.9 20 13.6l3.4-2.7M16.6 29.1 20 26.4l3.4 2.7" />
            </g>
          </svg>
        </span>
        <span class="logo__text">
          <span class="logo__word">{logo.wordmarkStart}<strong>{logo.wordmarkEnd}</strong></span>
          <span class="logo__desc">{logo.descriptor}</span>
        </span>
      </>
    )
  }
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--c-ink); min-height: 44px; }
  .logo img { height: 40px; width: auto; }
  .logo__mark { display: block; width: 38px; height: 38px; flex-shrink: 0; filter: drop-shadow(0 4px 10px rgb(2 132 199 / 0.25)); }
  .logo__mark svg { width: 100%; height: 100%; }
  .logo__text { display: flex; flex-direction: column; line-height: 1; }
  .logo__word { font-family: var(--font-display); font-size: 1.28rem; font-weight: 600; letter-spacing: -0.03em; }
  .logo__word strong { font-weight: 800; color: var(--c-primary); }
  .logo__desc { margin-top: 3px; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--c-muted); }
  .logo--dark { color: #fff; }
  .logo--dark .logo__word strong { color: var(--c-brand-light); }
  .logo--dark .logo__desc { color: rgb(255 255 255 / 0.6); }
</style>
