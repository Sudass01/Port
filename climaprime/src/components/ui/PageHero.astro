---
import Breadcrumbs from './Breadcrumbs.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { company } from '../../config/company';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  breadcrumbs: { name: string; path: string }[];
  image?: { src: string; alt: string };
  /** Mensagem do botão de WhatsApp. */
  waMessage?: string;
  primaryLabel?: string;
  primaryWa?: boolean;
  trackLabel?: string;
}
const {
  eyebrow,
  title,
  intro,
  breadcrumbs,
  image,
  waMessage = company.whatsappMessages.default,
  primaryLabel = 'Solicitar orçamento',
  primaryWa = false,
  trackLabel = 'page_hero',
} = Astro.props;
---

<section class="page-hero" data-hero>
  <div class:list={['container', 'ph', { 'ph--image': image }]}>
    <div class="ph__content">
      <Breadcrumbs items={breadcrumbs} />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {intro && <p class="lead">{intro}</p>}
      <div class="btn-row btn-row--stack">
        {primaryWa ? (
          <Button wa={waMessage} size="lg" track="commercial_quote_click" trackLabel={trackLabel}>{primaryLabel}</Button>
        ) : (
          <Button href="#orcamento" size="lg" arrow track="quote_cta_click" trackLabel={trackLabel}>{primaryLabel}</Button>
        )}
        {!primaryWa && <Button wa={waMessage} variant="outline" size="lg" trackLabel={trackLabel} icon="whatsapp">Falar no WhatsApp</Button>}
      </div>
      <ul class="ph__trust">
        <li><Icon name="circle-check" size={18} strokeWidth={2} />Orçamento gratuito</li>
        <li><Icon name="circle-check" size={18} strokeWidth={2} />{company.location.regionShort}</li>
        <li><Icon name="circle-check" size={18} strokeWidth={2} />Residências e empresas</li>
      </ul>
    </div>
    {image && (
      <div class="ph__media">
        <img src={image.src} alt={image.alt} width="1200" height="900" fetchpriority="high" decoding="async" />
      </div>
    )}
  </div>
</section>

<style>
  .ph { display: grid; gap: 36px; align-items: center; }
  @media (min-width: 1024px) { .ph--image { grid-template-columns: 1.1fr 0.9fr; gap: 56px; } }
  .ph__trust { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 22px; font-size: 0.9rem; font-weight: 550; color: var(--c-ink-2); }
  .ph__trust li { display: inline-flex; align-items: center; gap: 7px; }
  .ph__trust :global(.icon) { color: var(--c-success); }
  .ph__media { border-radius: 28px; overflow: hidden; border: 6px solid #fff; box-shadow: var(--shadow-lg); aspect-ratio: 4 / 3; background: var(--c-brand-50); }
  .ph__media img { width: 100%; height: 100%; object-fit: cover; }
</style>
