---
interface Props { rating?: number; size?: number; label?: boolean }
const { rating = 5, size = 16, label = true } = Astro.props;
---

<span class="stars" role={label ? 'img' : undefined} aria-label={label ? `${rating} de 5 estrelas` : undefined} aria-hidden={label ? undefined : 'true'}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg width={size} height={size} viewBox="0 0 20 20" aria-hidden="true" class:list={[{ off: i >= rating }]}>
      <path fill="currentColor" d="M10 1.6l2.47 5.2 5.7.68-4.2 3.93 1.1 5.64L10 14.27l-5.07 2.78 1.1-5.64-4.2-3.93 5.7-.68L10 1.6z" />
    </svg>
  ))}
</span>

<style>
  .stars { display: inline-flex; gap: 2px; color: var(--c-star); }
  .stars .off { color: var(--c-line); }
</style>
