---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
  id?: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, subtitle, center = false, id, as: Tag = 'h2' } = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': center }]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id}>{title}</Tag>
  {subtitle && <p>{subtitle}</p>}
  <slot />
</div>
