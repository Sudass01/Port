---
/** Conteúdo da página de um serviço: benefícios, quando fazer, sinais e etapas. */
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import type { ServicePage } from '../../config/services';
import { fill } from '../../lib/text';

interface Props { page: ServicePage; title: string; quoteOption: string; quoteLabel: string }
const { page, title, quoteOption, quoteLabel } = Astro.props;
---

<section class="section" aria-labelledby="beneficios-title">
  <div class="container">
    <SectionHeader id="beneficios-title" eyebrow="Benefícios" title={`Por que fazer ${title.toLowerCase()} com profissionais`} />
    <ul class="sd-benefits">
      {page.benefits.map((b, i) => (
        <li class="sd-benefit" data-reveal style={`--d:${i * 60}ms`}>
          <span class="icon-badge"><Icon name={b.icon} size={24} /></span>
          <h3>{b.title}</h3>
          <p>{fill(b.text)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section--alt" aria-label="Quando fazer e sinais de alerta">
  <div class="container sd-two">
    <div class="sd-panel" data-reveal>
      <span class="icon-badge"><Icon name="calendar-check" size={24} /></span>
      <h2>{page.whenTitle}</h2>
      <ul class="check-list">
        {page.when.map((w) => <li><Icon name="circle-check" size={20} />{fill(w)}</li>)}
      </ul>
    </div>
    <div class="sd-panel sd-panel--alert" data-reveal style="--d:80ms">
      <span class="icon-badge"><Icon name="circle-alert" size={24} /></span>
      <h2>{page.signsTitle}</h2>
      <ul class="check-list">
        {page.signs.map((s) => <li><Icon name="circle-alert" size={20} />{fill(s)}</li>)}
      </ul>
      <Button href="#orcamento" quote={quoteOption} quoteLabel={quoteLabel} arrow track="service_click" trackLabel={`signs_${quoteOption}`} class="sd-panel__cta">
        Identificou algum sinal? Peça seu orçamento
      </Button>
    </div>
  </div>
</section>

<style>
  .sd-benefits { list-style: none; display: grid; gap: 16px; }
  @media (min-width: 640px) { .sd-benefits { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sd-benefits { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
  .sd-benefit { padding: 24px; border-radius: 22px; border: 1px solid var(--c-line); background: #fff; }
  .sd-benefit h3 { margin: 18px 0 8px; font-size: 1.0625rem; }
  .sd-benefit p { color: var(--c-muted); font-size: 0.95rem; }

  .sd-two { display: grid; gap: 18px; }
  @media (min-width: 900px) { .sd-two { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .sd-panel { display: flex; flex-direction: column; padding: clamp(24px, 1.2rem + 1.5vw, 36px); border-radius: 26px; background: #fff; border: 1px solid var(--c-line); }
  .sd-panel h2 { font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem); margin: 18px 0 20px; }
  .sd-panel--alert .icon-badge { background: #fff7ed; color: #c2410c; border-color: #fed7aa; }
  .sd-panel--alert :global(.check-list .icon) { color: #ea580c; }
  .sd-panel :global(.sd-panel__cta) { margin-top: 26px; white-space: normal; text-align: left; justify-content: space-between; }
</style>
