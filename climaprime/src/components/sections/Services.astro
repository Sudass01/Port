---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { services, serviceHref } from '../../config/services';
import { servicesSection } from '../../config/content';

interface Props {
  /** Na página /servicos o título vira H1 em outro lugar; aqui pode ser escondido. */
  showHeader?: boolean;
  id?: string;
}
const { showHeader = true, id = 'servicos' } = Astro.props;
---

<section id={id} class="section services" aria-labelledby={showHeader ? `${id}-title` : undefined} aria-label={showHeader ? undefined : 'Serviços'}>
  <div class="container">
    {showHeader && <SectionHeader id={`${id}-title`} eyebrow={servicesSection.eyebrow} title={servicesSection.title} subtitle={servicesSection.subtitle} />}
    <ul class="services__grid">
      {services.map((s, i) => (
        <li class="service-card" data-reveal style={`--d:${(i % 3) * 70}ms`}>
          <div class="service-card__top">
            <span class="icon-badge service-card__icon"><Icon name={s.icon} size={24} /></span>
            <span class="service-card__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          <div class="service-card__actions">
            <a
              href="#orcamento"
              class="btn btn--outline btn--sm service-card__cta"
              data-quote-service={s.quote.option}
              data-quote-label={s.quote.label}
              data-track="service_click"
              data-track-label={s.id}
            >
              Solicitar orçamento
              <Icon name="arrow-right" size={18} class="btn__arrow" />
            </a>
            <a href={serviceHref(s)} class="service-card__more" aria-label={`Saiba mais sobre ${s.title}`}>Saiba mais</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services__grid { list-style: none; display: grid; gap: 16px; }
  @media (min-width: 640px) { .services__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  @media (min-width: 1024px) { .services__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px 24px 22px;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out), border-color 0.3s var(--ease);
  }
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--c-brand-light), var(--c-primary));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }
  @media (hover: hover) {
    .service-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--c-brand-100); }
    .service-card:hover::before { transform: scaleX(1); }
    .service-card:hover .service-card__icon { background: var(--c-primary); color: #fff; border-color: var(--c-primary); }
  }
  .service-card__top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 22px; }
  .service-card__icon { transition: background-color 0.3s var(--ease), color 0.3s var(--ease); }
  .service-card__num { font-family: var(--font-display); font-size: 0.85rem; font-weight: 700; color: var(--c-line); letter-spacing: 0.04em; }
  .service-card h3 { margin-bottom: 10px; }
  .service-card p { color: var(--c-muted); font-size: 0.97rem; flex: 1; }
  .service-card__actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--c-line-soft); }
  .service-card__more { white-space: nowrap; display: inline-flex; align-items: center; min-height: 44px; padding: 0 4px; font-size: 0.9rem; font-weight: 600; color: var(--c-muted); text-decoration: none; }
  .service-card__more:hover { color: var(--c-primary); text-decoration: underline; }
</style>
