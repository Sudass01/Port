---
import Icon from '../ui/Icon.astro';
import { trustBar } from '../../config/content';
---

<div class="trustbar" aria-label="Tipos de atendimento">
  <div class="container">
    <ul class="trustbar__list" data-reveal>
      {trustBar.map((item) => (
        <li>
          <span class="trustbar__icon"><Icon name={item.icon} size={20} /></span>
          <span>{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .trustbar { position: relative; z-index: 2; margin-top: -48px; }
  .trustbar__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    padding: 10px;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: 20px;
    box-shadow: var(--shadow-md);
  }
  .trustbar__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    min-width: 0;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--c-ink);
  }
  .trustbar__list li:last-child { grid-column: 1 / -1; }
  .trustbar__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 11px;
    background: var(--c-brand-50);
    color: var(--c-brand);
  }
  @media (min-width: 720px) {
    .trustbar__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .trustbar__list li:last-child { grid-column: auto; }
  }
  @media (min-width: 1024px) {
    .trustbar__list { grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 14px 8px; }
    .trustbar__list li { justify-content: center; padding: 8px 12px; font-size: 0.9rem; }
    .trustbar__list li + li { border-left: 1px solid var(--c-line-soft); }
  }
</style>
