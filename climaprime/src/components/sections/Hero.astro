---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Stars from '../ui/Stars.astro';
import { hero } from '../../config/content';
import { company } from '../../config/company';
---

<section id="inicio" class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__eyebrow hero-in" style="--d:0ms">
        <span class="pulse" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>
      <h1 id="hero-title" class="hero-in" style="--d:60ms">{hero.title}</h1>
      <p class="hero__highlight hero-in" style="--d:120ms">{hero.highlight}</p>
      <p class="hero__subtitle hero-in" style="--d:160ms">{hero.subtitle}</p>
      <div class="btn-row btn-row--stack hero__ctas hero-in" style="--d:220ms">
        <Button href="#orcamento" size="lg" arrow track="quote_cta_click" trackLabel="hero">{hero.primaryCta}</Button>
        <Button href="#servicos" variant="outline" size="lg">{hero.secondaryCta}</Button>
      </div>
      <ul class="hero__trust hero-in" style="--d:280ms" aria-label="Diferenciais">
        {hero.trust.map((t) => (
          <li><Icon name="circle-check" size={18} strokeWidth={2} />{t}</li>
        ))}
      </ul>
    </div>

    <div class="hero__visual hero-in" style="--d:140ms">
      <svg class="hero__airflow" viewBox="0 0 400 160" aria-hidden="true">
        <path d="M10 40c60-30 120 30 190 0s130-30 190 0" />
        <path d="M10 80c60-30 120 30 190 0s130-30 190 0" />
        <path d="M10 120c60-30 120 30 190 0s130-30 190 0" />
      </svg>
      <div class="hero__frame">
        <img
          src={hero.image.src}
          alt={hero.image.alt}
          width="960"
          height="1120"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="float float--rating" aria-hidden="true">
        <Stars rating={hero.cards.rating.stars} size={15} label={false} />
        <strong>{hero.cards.rating.title}</strong>
        <span>{hero.cards.rating.text}</span>
      </div>

      <div class="float float--temp" aria-hidden="true">
        <span class="temp__icon"><Icon name="snowflake" size={18} /></span>
        <span class="temp__value">{hero.cards.temperature.value}<small>C</small></span>
        <span class="temp__meta">
          <strong>{hero.cards.temperature.label}</strong>
          <span>{hero.cards.temperature.mode}</span>
        </span>
        <span class="temp__bar"><span></span></span>
      </div>

      <div class="float float--fast" aria-hidden="true">
        <span class="fast__icon"><Icon name="whatsapp" size={20} /></span>
        <span>
          <strong>{hero.cards.fast.title}</strong>
          <span>{hero.cards.fast.text}</span>
        </span>
      </div>

      <div class="float float--badge" aria-hidden="true">
        <span class="pulse"></span>
        {hero.cards.badge} · {company.location.city}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(2rem, 1.2rem + 3vw, 4.5rem);
    padding-bottom: clamp(5rem, 4rem + 4vw, 7.5rem);
    overflow: clip;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(720px 520px at 88% 8%, color-mix(in srgb, var(--c-brand-light) 22%, transparent), transparent 70%),
      radial-gradient(600px 400px at -5% 100%, var(--c-brand-50), transparent 70%),
      linear-gradient(180deg, #fff 0%, var(--c-surface) 100%);
  }
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--c-primary) 14%, transparent) 1px, transparent 0);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 60% 70% at 80% 30%, #000 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 80% 30%, #000 10%, transparent 75%);
    opacity: 0.6;
  }

  .hero__grid { display: grid; gap: clamp(3rem, 2rem + 4vw, 4rem); align-items: center; }
  @media (min-width: 1024px) {
    .hero__grid { grid-template-columns: 1.05fr 0.95fr; gap: 56px; }
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    padding: 7px 14px 7px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-xs);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-ink-2);
  }
  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #22c55e;
    opacity: 0;
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.6); opacity: 0.7; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  h1 { max-width: 15ch; }
  .hero__highlight {
    margin-top: 22px;
    padding-left: 16px;
    border-left: 3px solid var(--c-brand);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    font-weight: 600;
    line-height: 1.5;
    color: var(--c-ink);
    max-width: 36ch;
  }
  .hero__subtitle { margin-top: 12px; color: var(--c-muted); font-size: clamp(1rem, 0.97rem + 0.2vw, 1.0625rem); max-width: 46ch; }
  .hero__ctas { margin-top: 30px; }
  .hero__trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 28px;
    font-size: 0.925rem;
    font-weight: 550;
    color: var(--c-ink-2);
  }
  .hero__trust li { display: inline-flex; align-items: center; gap: 8px; }
  .hero__trust :global(.icon) { color: var(--c-success); }

  /* Visual */
  .hero__visual {
    position: relative;
    max-width: 560px;
    width: 100%;
    margin-inline: auto;
    padding: 18px 10px 26px;
  }
  @media (min-width: 1024px) { .hero__visual { margin-right: 0; padding: 26px 0 30px 34px; } }
  .hero__frame {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 6 / 7;
    background: var(--c-brand-50);
    box-shadow: var(--shadow-lg);
    border: 6px solid #fff;
  }
  @media (max-width: 639px) { .hero__frame { aspect-ratio: 1 / 1; } }
  .hero__frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .hero__airflow {
    position: absolute;
    left: -30px;
    top: 30%;
    width: 120%;
    z-index: -1;
    fill: none;
    stroke: color-mix(in srgb, var(--c-brand-light) 55%, transparent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 6 10;
    opacity: 0.7;
  }

  .float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: rgb(255 255 255 / 0.97);
    border: 1px solid var(--c-line-soft);
    border-radius: 16px;
    box-shadow: 0 18px 40px -16px rgb(15 23 42 / 0.28);
    font-size: 0.8rem;
    line-height: 1.3;
    color: var(--c-muted);
    animation: float-in 0.9s var(--ease-out) both, bob 7s var(--ease) 1.2s infinite;
  }
  .float strong { display: block; color: var(--c-ink); font-size: 0.9rem; font-weight: 700; }

  .float--rating { top: 0; left: 0; flex-direction: column; align-items: flex-start; gap: 3px; animation-delay: 0.45s, 1.4s; }
  .float--temp { top: 24%; right: -4px; flex-wrap: wrap; width: 182px; gap: 10px; animation-delay: 0.6s, 2.2s; }
  .float--fast { bottom: 6px; right: 10px; animation-delay: 0.75s, 3s; }
  .float--badge {
    bottom: 22%;
    left: -6px;
    padding: 9px 14px;
    border-radius: 999px;
    font-weight: 650;
    color: var(--c-ink);
    gap: 9px;
    animation-delay: 0.9s, 2.6s;
  }
  @media (min-width: 1024px) {
    .float--rating { left: 0; top: 4px; }
    .float--temp { right: -26px; }
    .float--fast { right: -18px; bottom: 0; }
    .float--badge { left: 6px; }
  }
  @media (max-width: 479px) {
    .float { padding: 10px 12px; }
    .float--temp { display: none; }
    .float--badge { bottom: 30%; }
  }

  .temp__icon, .fast__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    flex-shrink: 0;
  }
  .temp__icon { background: var(--c-brand-50); color: var(--c-brand); }
  .temp__value { font-family: var(--font-display); font-size: 1.9rem; font-weight: 800; letter-spacing: -0.04em; color: var(--c-ink); line-height: 1; }
  .temp__value small { font-size: 0.9rem; font-weight: 700; margin-left: 1px; color: var(--c-muted); }
  .temp__meta { width: 100%; }
  .temp__meta strong { font-size: 0.85rem; }
  .temp__bar { width: 100%; height: 6px; border-radius: 99px; background: var(--c-line-soft); overflow: hidden; }
  .temp__bar span { display: block; width: 62%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--c-brand-light), var(--c-primary)); }
  .fast__icon { background: color-mix(in srgb, var(--c-wa) 12%, #fff); color: var(--c-wa); }

  @keyframes float-in { from { opacity: 0; transform: translateY(14px) scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -5px; } }

  /* Entrada suave do conteúdo */
  html:global(.js) .hero-in { animation: hero-in 0.9s var(--ease-out) both; animation-delay: var(--d, 0ms); }
  @keyframes hero-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
</style>
