---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { areasSection } from '../../config/content';
import { company } from '../../config/company';

interface Props { showHeader?: boolean }
const { showHeader = true } = Astro.props;
const { cities, neighborhoods } = company.serviceAreas;

// Posições dos pinos no mapa ilustrativo (a 1ª cidade fica no centro).
const spots = [
  { x: 50, y: 48 },
  { x: 70, y: 70 },
  { x: 76, y: 36 },
  { x: 24, y: 40 },
  { x: 33, y: 20 },
  { x: 30, y: 74 },
  { x: 62, y: 16 },
];
---

<section id="areas" class="section section--alt" aria-labelledby={showHeader ? 'areas-title' : undefined} aria-label={showHeader ? undefined : 'Regiões atendidas'}>
  <div class="container">
    {showHeader && <SectionHeader id="areas-title" eyebrow={areasSection.eyebrow} title={areasSection.title} subtitle={areasSection.subtitle} />}

    <div class="areas">
      <div class="areas__map" data-reveal aria-hidden="true">
        <svg viewBox="0 0 100 92" preserveAspectRatio="xMidYMid slice">
          <defs>
            <radialGradient id="area-glow" cx="50%" cy="52%" r="50%">
              <stop offset="0" stop-color="var(--c-brand-light)" stop-opacity="0.32" />
              <stop offset="1" stop-color="var(--c-brand-light)" stop-opacity="0" />
            </radialGradient>
          </defs>
          <rect width="100" height="92" fill="#fff" />
          <g stroke="var(--c-line)" stroke-width="0.35" fill="none">
            {Array.from({ length: 12 }, (_, i) => <path d={`M0 ${i * 8} H100`} />)}
            {Array.from({ length: 13 }, (_, i) => <path d={`M${i * 8} 0 V92`} />)}
          </g>
          <circle cx="50" cy="48" r="44" fill="url(#area-glow)" />
          <circle cx="50" cy="48" r="34" fill="none" stroke="var(--c-brand-200)" stroke-width="0.4" stroke-dasharray="1.4 1.4" />
          <circle cx="50" cy="48" r="18" fill="none" stroke="var(--c-brand-200)" stroke-width="0.4" stroke-dasharray="1.4 1.4" />
          <g stroke="var(--c-brand-200)" stroke-width="1.1" fill="none" stroke-linecap="round">
            <path d="M2 60 C20 54 34 52 50 48 S82 40 98 30" />
            <path d="M18 92 C26 76 40 60 50 48 S62 20 66 0" />
            <path d="M50 48 C58 58 64 64 70 70 S86 84 98 88" />
          </g>
          {cities.slice(0, spots.length).map((c, i) => (
            <g transform={`translate(${spots[i].x} ${spots[i].y})`}>
              {i === 0 && <circle r="5.5" fill="var(--c-brand)" opacity="0.14" />}
              <circle r={i === 0 ? 2.6 : 1.8} fill={i === 0 ? 'var(--c-primary)' : '#fff'} stroke="var(--c-primary)" stroke-width="0.9" />
              <text y={i === 0 ? -5 : -3.6} text-anchor="middle" font-size={i === 0 ? 3.6 : 2.9} font-weight={i === 0 ? 700 : 600} fill="var(--c-ink)" font-family="var(--font-sans)">{c.name}</text>
            </g>
          ))}
        </svg>
        <span class="areas__map-badge"><Icon name="navigation" size={16} />Atendimento no local</span>
      </div>

      <div class="areas__info">
        <h3 class="areas__subtitle" data-reveal>{areasSection.citiesTitle}</h3>
        <ul class="cities" data-reveal>
          {cities.map((c) => (
            <li>
              <span class="cities__icon"><Icon name="map-pin" size={18} /></span>
              <span>
                <strong>{c.name}</strong>
                <span>{c.note}</span>
              </span>
            </li>
          ))}
        </ul>

        <h3 class="areas__subtitle" data-reveal>{areasSection.neighborhoodsTitle}</h3>
        <ul class="hoods" data-reveal>
          {neighborhoods.map((n) => <li class="chip">{n}</li>)}
          <li class="chip chip--more">e outros bairros</li>
        </ul>
      </div>
    </div>

    <div class="areas__cta" data-reveal>
      <span class="areas__cta-icon"><Icon name="search" size={24} /></span>
      <div>
        <p class="areas__cta-title">{areasSection.notFoundTitle}</p>
        <p>{areasSection.notFoundText}</p>
      </div>
      <Button wa={company.whatsappMessages.area} trackLabel="areas_not_found">{areasSection.notFoundCta}</Button>
    </div>
  </div>
</section>

<style>
  .areas { display: grid; gap: 28px; align-items: start; }
  @media (min-width: 960px) { .areas { grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; } }

  .areas__map {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-md);
    aspect-ratio: 100 / 92;
    background: #fff;
  }
  .areas__map svg { width: 100%; height: 100%; }
  .areas__map-badge {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #fff;
    box-shadow: var(--shadow-sm);
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--c-ink);
  }
  .areas__map-badge :global(.icon) { color: var(--c-brand); }

  .areas__subtitle { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); margin-bottom: 14px; }
  .areas__subtitle + .cities { margin-bottom: 28px; }
  .cities { list-style: none; display: grid; gap: 10px; }
  @media (min-width: 560px) { .cities { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cities li { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 16px; background: #fff; border: 1px solid var(--c-line); }
  .cities li:first-child { border-color: var(--c-brand-200); background: var(--c-brand-50); }
  .cities strong { display: block; font-size: 0.97rem; color: var(--c-ink); line-height: 1.3; }
  .cities li > span:last-child > span { font-size: 0.82rem; color: var(--c-muted); }
  .cities__icon { display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0; border-radius: 11px; background: var(--c-brand-50); color: var(--c-brand); }
  .cities li:first-child .cities__icon { background: var(--c-primary); color: #fff; }
  .hoods { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip--more { background: transparent; border-style: dashed; color: var(--c-muted); }

  .areas__cta {
    display: grid;
    gap: 16px;
    align-items: center;
    margin-top: 36px;
    padding: 22px;
    border-radius: 22px;
    background: #fff;
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
  }
  @media (min-width: 768px) { .areas__cta { grid-template-columns: auto 1fr auto; gap: 20px; padding: 24px 28px; } }
  .areas__cta-icon { display: none; place-items: center; width: 54px; height: 54px; border-radius: 16px; background: var(--c-brand-50); color: var(--c-brand); }
  @media (min-width: 768px) { .areas__cta-icon { display: grid; } }
  .areas__cta-title { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: var(--c-ink); margin: 0; }
  .areas__cta p:not(.areas__cta-title) { color: var(--c-muted); margin: 2px 0 0; }
</style>
