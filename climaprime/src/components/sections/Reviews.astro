---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import Stars from '../ui/Stars.astro';
import { reviews, reviewsSection } from '../../config/reviews';
import { company } from '../../config/company';

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .replace(/[^A-Za-zÀ-ÿ]/g, '')
    .slice(0, 2)
    .toUpperCase();
---

<section id="avaliacoes" class="section" aria-labelledby="avaliacoes-title">
  <div class="container" data-carousel>
    <div class="reviews__head">
      <SectionHeader id="avaliacoes-title" eyebrow="Avaliações" title={reviewsSection.title} subtitle={reviewsSection.subtitle}>
        {company.demoMode && (
          <p class="demo-note"><Icon name="circle-alert" size={15} />Avaliações ilustrativas, usadas para demonstração do modelo.</p>
        )}
      </SectionHeader>
      <div class="reviews__arrows" data-reveal>
        <button type="button" class="carousel__arrow" data-carousel-prev aria-label="Avaliações anteriores"><Icon name="chevron-left" size={22} /></button>
        <button type="button" class="carousel__arrow" data-carousel-next aria-label="Próximas avaliações"><Icon name="chevron-right" size={22} /></button>
      </div>
    </div>

    <ul class="reviews" data-carousel-track aria-label="Avaliações de clientes" tabindex="0">
      {reviews.map((r) => (
        <li class="review">
          <figure>
            <div class="review__top">
              <Stars rating={r.rating} />
              <Icon name="quote" size={28} class="review__quote" />
            </div>
            <blockquote><p>“{r.text}”</p></blockquote>
            <figcaption>
              <span class="review__avatar" aria-hidden="true">{initials(r.name)}</span>
              <span>
                <strong>{r.name}</strong>
                <span>{r.location}{r.service && ` · ${r.service}`}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <div class="carousel__dots" data-carousel-dots></div>

    {reviewsSection.moreReviewsUrl && (
      <p class="reviews__more"><a class="text-link" href={reviewsSection.moreReviewsUrl} target="_blank" rel="noopener">{reviewsSection.moreReviewsLabel}<Icon name="arrow-right" size={18} /></a></p>
    )}
  </div>
</section>

<script>
  import '../../scripts/carousel';
</script>

<style>
  .reviews__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .reviews__head :global(.demo-note) { margin-top: 12px; }
  .reviews__arrows { display: none; gap: 10px; margin-bottom: clamp(2.25rem, 1.8rem + 2vw, 3.5rem); }
  @media (min-width: 768px) { .reviews__arrows { display: flex; } }
  .carousel__arrow {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid var(--c-line);
    background: #fff;
    color: var(--c-ink);
    transition: all 0.2s var(--ease);
  }
  .carousel__arrow:hover:not(:disabled) { background: var(--c-ink); color: #fff; border-color: var(--c-ink); }
  .carousel__arrow:disabled { opacity: 0.4; cursor: default; }

  .reviews {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    padding: 4px 2px 10px;
    margin: -4px -2px 0;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .reviews::-webkit-scrollbar { display: none; }
  .reviews:focus-visible { outline-offset: 6px; }
  @media (min-width: 640px) { .reviews { grid-auto-columns: calc((100% - 20px) / 2); gap: 20px; } }
  @media (min-width: 1024px) { .reviews { grid-auto-columns: calc((100% - 48px) / 3); gap: 24px; } }

  .review { scroll-snap-align: start; display: flex; }
  .review figure {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    padding: 26px 24px 22px;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-xs);
  }
  .review__top { display: flex; justify-content: space-between; align-items: center; }
  .review :global(.review__quote) { color: var(--c-brand-100); }
  .review blockquote { margin: 16px 0 22px; flex: 1; }
  .review blockquote p { font-size: 1.03rem; line-height: 1.6; color: var(--c-ink); }
  .review figcaption { display: flex; align-items: center; gap: 12px; padding-top: 18px; border-top: 1px solid var(--c-line-soft); font-size: 0.875rem; color: var(--c-muted); }
  .review figcaption strong { display: block; color: var(--c-ink); font-size: 0.95rem; }
  .review__avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--c-brand-100), var(--c-brand-200));
    color: var(--c-primary-deep);
    font-weight: 750;
    font-size: 0.85rem;
  }

  .carousel__dots { display: flex; justify-content: center; gap: 8px; margin-top: 20px; }
  .carousel__dots :global(.carousel__dot) {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: none;
    display: grid;
    place-items: center;
  }
  .carousel__dots :global(.carousel__dot)::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: var(--c-line);
    transition: all 0.3s var(--ease-out);
  }
  .carousel__dots :global(.carousel__dot[aria-current='true'])::before { width: 22px; background: var(--c-primary); }
  .reviews__more { margin-top: 18px; text-align: center; }
</style>
