---
/** Botão flutuante de WhatsApp (desktop/tablet). No celular, quem faz esse papel é a barra inferior (MobileCTA). */
import Icon from '../ui/Icon.astro';
import { company } from '../../config/company';
import { whatsappUrl } from '../../lib/whatsapp';
const msg = company.whatsappMessages.default;
---

<a
  href={whatsappUrl(msg)}
  class="wa-float"
  target="_blank"
  rel="noopener"
  data-wa
  data-wa-message={msg}
  data-track-label="floating_button"
  aria-label="Solicite seu orçamento pelo WhatsApp"
>
  <span class="wa-float__label" aria-hidden="true">Solicite seu orçamento</span>
  <span class="wa-float__icon"><Icon name="whatsapp" size={30} /></span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 50;
    display: none;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    animation: wa-in 0.6s var(--ease-out) 1.2s both;
  }
  @media (min-width: 768px) { .wa-float { display: inline-flex; } }
  .wa-float__icon {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #1fa855;
    color: #fff;
    box-shadow: 0 12px 28px -8px rgb(21 128 61 / 0.55), 0 0 0 0 rgb(31 168 85 / 0.4);
    transition: transform 0.25s var(--ease-out), background-color 0.2s var(--ease);
  }
  .wa-float__label {
    padding: 10px 16px;
    border-radius: 999px;
    background: #fff;
    color: var(--c-ink);
    font-weight: 650;
    font-size: 0.92rem;
    white-space: nowrap;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--c-line-soft);
    opacity: 0;
    transform: translateX(10px);
    pointer-events: none;
    transition: opacity 0.25s var(--ease), transform 0.3s var(--ease-out);
  }
  .wa-float:hover .wa-float__icon,
  .wa-float:focus-visible .wa-float__icon { transform: scale(1.06); background: var(--c-wa); }
  .wa-float:hover .wa-float__label,
  .wa-float:focus-visible .wa-float__label { opacity: 1; transform: none; }
  .wa-float:focus-visible { outline: none; }
  .wa-float:focus-visible .wa-float__icon { outline: 3px solid var(--c-brand-light); outline-offset: 3px; }
  @keyframes wa-in { from { opacity: 0; transform: translateY(16px) scale(0.9); } to { opacity: 1; transform: none; } }
</style>
