# ==========================================================================
# FIREBASE
# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto.
# Console do Firebase -> Configurações do projeto -> Seus apps -> Web.
#
# O site funciona SEM estas variáveis (usando os dados de src/data/),
# mas o painel em /admin só liga quando elas existem.
# ==========================================================================

# Endereço público do site (SEO, sitemap e Open Graph).
# Na Netlify: https://seu-site.netlify.app (ou seu domínio próprio).
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
